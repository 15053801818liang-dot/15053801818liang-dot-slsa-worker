{
  // Cloudflare Workers 配置 — SLSA L3 加固模板
  // 文档: https://developers.cloudflare.com/workers/wrangler/configuration/
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slsa-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",

  // Durable Object 绑定
  "durable_objects": {
    "bindings": [
      {
        "name": "COUNTER",
        "class_name": "CounterDO"
      }
    ]
  },

  // DO 迁移声明（首次部署需要 new_sqlite_classes — 免费计划必须用 SQLite 后端）
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CounterDO"]
    }
  ],

  // 生产环境观察性（可选）
  "observability": {
    "enabled": true
  }
}
